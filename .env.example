# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Random string, 32+ characters. Generate: openssl rand -hex 32
AUTH_SECRET=

# First admin account, created by `npm run db:seed`
ADMIN_EMAIL=you@university.edu
ADMIN_PASSWORD=

# Public URL of the site (used for SEO, sitemap, citations)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: email notifications for contact form (Resend)
RESEND_API_KEY=
CONTACT_TO=
CONTACT_FROM=

# Optional: file storage on Vercel Blob (otherwise files are stored in ./uploads)
BLOB_READ_WRITE_TOKEN=